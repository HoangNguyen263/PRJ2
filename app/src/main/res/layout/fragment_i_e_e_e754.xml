<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="8dp"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:background="@drawable/scrollview_background"
        android:padding="8dp"
        android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ieee754_theory"
            android:textSize="14sp"
            android:padding="16dp"
            android:textColor="@color/black"
            android:elevation="2dp"
            android:lineSpacingExtra="4dp"
            android:letterSpacing="0.05"
            android:scrollbars="none"
            />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="5dp"
            android:translationZ="3dp"
            app:cardCornerRadius="8dp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    >
                    <EditText
                        android:id="@+id/float_input"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter Float Number"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>


                <Button
                    android:id="@+id/convert_to_binary_button"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="8dp"
                    android:background="@color/colorPrimary"
                    android:textColor="@color/white"
                    android:text="Convert to IEEE 754" />

                <TextView
                    android:id="@+id/ieee754_output"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:paddingLeft="8dp"
                    android:gravity=""
                    android:textColor="@color/black"
                    android:text="IEEE 754 String will be displayed here" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="5dp"
            android:translationZ="3dp"
            app:cardCornerRadius="8dp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    >
                    <EditText
                        android:id="@+id/binary_input"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter Binary String (32-bit)"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>


                <Button
                    android:id="@+id/convert_to_float_button"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="8dp"
                    android:background="@color/colorPrimary"
                    android:textColor="@color/white"
                    android:text="Convert to Float" />

                <TextView
                    android:id="@+id/float_output"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:paddingLeft="8dp"
                    android:gravity=""
                    android:textColor="@color/black"
                    android:text="Float Number will be displayed here" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>

</LinearLayout>